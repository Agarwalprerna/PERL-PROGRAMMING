use design;

sub average{
 
     $num = scalar(@_) ;    # no. of arguments are accessed using @_
     $sum =0;
     
     foreach $i(@_){
         $sum += $i;
         }
         $avg = $sum/$num;
         
         
    print"average os numbers = $avg\n";   #or return $avg;
 }
 
 #function call
 average(10 ,30,89,40);
 
 
