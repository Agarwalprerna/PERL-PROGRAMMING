print"---------------------Quantifiers example-------------\n";
#how many times a pattern occur

my $str2 = "abbbbbc";

if($str2 =~ /ab*c/){             #ac, abc,abbc,abbbbc 0 or more times
     print" (*) matched more than 1 \n";
     }
 else {
     print" (*) Not matched\n";
     }
     
      
if($str2 =~ /ab+c/){             # abc,abbc,abbbbc   1 or more times
     print" (+) matched more than 1 \n";    #doesn't match ac
     }
 else {
     print" (+) Not matched\n";

}

if($str2 =~ /b{3}/){             
     print" matched exactly 3 b's \n";
     }
 else {
     print" Not exactly 3 b's matched\n";
     }
     
     
if($str2 =~ /b{2,}/){             #abc, abbc,abbbc, abbbbbc
     print"  matched more than 2 b's \n";
     }
 else {  
     print" Not matched more than 2 b's \n";
     }     
     
my $str3 = "colour";
     
if($str3 =~ /colo?r/){             #colour , color
     print" (?) matched  \n";
     }
 else {
     print" (?) Not matched\n";
     }
 
 
 
