    {
       print" Match found! \n";
     }
else {
        print"No MATCH\n";
     }
print"---------------------------\n";

# for case sensitove ise "i"
if($text =~ /perl/i)
   {
      print "case sensitive : match found\n";
   }   
  
print"---------------------------\n";

# $' , $` , $& 
 if($text =~ /powerful/)
     {
          print"before match: $` \n";  #return string 
          print"after match: $' \n";   #return string
          print"matched: $& \n";         #return string 
          
     }     
  
print"------------Substitution Matching--------------------\n";

