        {
         print "contain a number! \n";
         }
         



my $str = "name: john Age: 35";
if ($str =~ /name:\s(\w+)\s age: \s(\d+)/)
          {
             print"name: $1 , Age: $2\n";
          }   
else {
         print" not found\n";
      }   


if( $str =~ /j.n/){                        
          print"single charachter(.) matched\n ";    #j to n
          }
else {
          print" single charachter(.) match not found\n";
      }    
          

if($str =~ /^name/){        #matches only  if name is at beginning
      print" start of string (^) match found\n";   
      }
             
else {
          print" start of string(^) match not found\n";
      }     


if($str =~ /\w+/){
     print" matched more than 1 charachter (\w)\n";
     }
else {
        print" match not found \w \n";
     }

if($str =~ /\s/) {
     print"whitespace found\n";
     }
else {
     print"white space is not found\n";
     }
     
#combined example

