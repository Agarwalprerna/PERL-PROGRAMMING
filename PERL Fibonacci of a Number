my $number = 4;
my $n1 = 0;
my $n2 = 1;


print "$n1\n";
print "$n2\n";

for( my $k=2; $k < $number ; $k++){
         my $n3 = $n1 + $n2;
         print "$n3\n";
         $n1 = $n2;
         $n2 = $n3;
