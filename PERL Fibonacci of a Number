####################################################################################2. function 
sub fibonacci{

        my $N = $_[0];
        
        if ($N <0){
                 return "fibonacci is not defined";
        }
        elsif ($N==0){
                 return 0;
        }
        elsif( $N == 1){
                 return 1;
        }
        else{
                 return fibonacci($N-1) + fibonacci($N-2);
        }
}
my $r = 4;
my $fib_res = fibonacci($r);
print"fibonacci of $r = $fib_res\n";
        

       
