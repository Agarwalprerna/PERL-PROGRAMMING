#array in perl are mutable
@fruits = ("mango" , 'apple ' , "kiwi" , 'orange' );

#push to add element in the end
push( @fruits , "beet");
print"@fruits\n";

#unshift to add element in the begining
unshift(@fruits , "guava");
print"@fruits\n";

#shift to add remove element from beginning
shift( @fruits );
print"@fruits\n";

#pop to remove last element
pop(@fruits);
print"@fruits\n";

#slicing
print"@fruits[0,3,4]\n";
print"@fruits[0..2]\n";     #using range operator for speed 

@fav = @fruits[0,1,3];   #creating another array through slicing
